---
import type { Project } from '../data/projects';

export interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class="card-surface overflow-hidden group">
  <!-- Зображення / плейсхолдер -->
  <div class="aspect-video bg-paper-bg dark:bg-graphite-bg border-b border-paper-border dark:border-graphite-border flex items-center justify-center relative overflow-hidden">
    {
      project.image ? (
        <img src={project.image} alt={project.title} class="w-full h-full object-cover" loading="lazy" />
      ) : (
        <>
          <div class="bg-blueprint-grid bg-grid absolute inset-0 opacity-60"></div>
          <p class="relative font-mono text-xs text-paper-textMuted dark:text-graphite-textMuted">
            [screenshot pending]
          </p>
        </>
      )
    }
  </div>

  <div class="p-5">
    <div class="flex items-start justify-between gap-3 mb-2">
      <p class="font-mono text-xs text-copper">MODULE_{num}</p>
      <span
        class:list={[
          'font-mono text-[10px] uppercase tracking-wide px-2 py-0.5 rounded-full border',
          project.status === 'done'
            ? 'border-cyan/40 text-cyan'
            : 'border-copper/40 text-copper',
        ]}
      >
        {project.status === 'done' ? 'done' : 'in progress'}
      </span>
    </div>

    <h3 class="font-display font-semibold text-lg mb-2">{project.title}</h3>
    <p class="text-sm text-paper-textMuted dark:text-graphite-textMuted leading-relaxed mb-4">
      {project.summary}
    </p>

    {
      project.highlights.length > 0 && (
        <ul class="space-y-1.5 mb-4">
          {project.highlights.slice(0, 3).map((h) => (
            <li class="text-xs text-paper-textMuted dark:text-graphite-textMuted flex gap-2">
              <span class="text-copper shrink-0">▸</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="flex flex-wrap gap-1.5 mb-4">
      {
        project.stack.map((tech) => (
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-paper-bg dark:bg-graphite-bg border border-paper-border dark:border-graphite-border">
            {tech}
          </span>
        ))
      }
    </div>

    {
      project.links.length > 0 && (
        <div class="flex gap-4 pt-3 border-t border-paper-border dark:border-graphite-border">
          {project.links.map((link) => (
            <a
              href={link.url}
              class="font-mono text-xs text-cyan hover:text-copper transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label} →
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
