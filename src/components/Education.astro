---
const education = [
  {
    degree: "Bachelor's Degree — Automation, Computer-Integrated Technologies & Robotics",
    school: 'Kyiv Polytechnic Institute (КПІ)',
    period: 'Expected 2028',
    notes: 'Modern Programming Technologies, Modular Programming, Numerical Methods, Fundamentals of Automation and Robotics, Engineering & Computer Graphics (AutoCAD)',
  },
  {
    degree: "Junior Bachelor's Degree — Computer Science",
    school: 'Bila Tserkva Professional College of Mechanics and Energy',
    period: 'Graduated 2024',
    notes: 'OOP, Python Programming, Computer Networks & Protocols, Computer Graphics (Adobe Photoshop)',
  },
];
---

<section id="education" class="py-24 border-t border-paper-border dark:border-graphite-border">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-3 mb-10">
      <span class="w-2 h-2 rounded-full bg-copper animate-tracePulse"></span>
      <p class="section-label">Освіта</p>
    </div>

    <div class="relative pl-6 space-y-10 before:content-[''] before:absolute before:left-[3px] before:top-2 before:bottom-2 before:w-px before:bg-paper-border dark:before:bg-graphite-border">
      {
        education.map((item) => (
          <div class="relative">
            <span class="absolute -left-6 top-1.5 w-2 h-2 rounded-full bg-copper" />
            <p class="font-mono text-xs text-copper mb-1">{item.period}</p>
            <h3 class="font-display font-semibold text-lg">{item.degree}</h3>
            <p class="text-sm text-paper-textMuted dark:text-graphite-textMuted mb-2">{item.school}</p>
            <p class="text-xs text-paper-textMuted dark:text-graphite-textMuted leading-relaxed max-w-2xl">
              {item.notes}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
