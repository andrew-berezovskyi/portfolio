---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/workspace.css';
import SkillsIsland from './interactive/SkillsIsland';
import ContactLinks from './interactive/ContactLinks';
import ProjectShowcase from './interactive/ProjectShowcase';
import { github, certificate, type Lang } from '../data/workspace';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const uk = lang === 'uk';
const t = (en: string, ua: string) => (uk ? ua : en);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localPath = (path = '') => `${base}${path.replace(/^\//, '')}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101111" />
    <title>Andrew Berezovskyi — Developer & curious mind</title>
    <meta
      name="description"
      content={t(
        'C# / .NET developer exploring the space between software, systems and the web. Selected work by Andrew Berezovskyi.',
        'C# / .NET розробник. Досліджую світ застосунків, систем і вебу. Вибрані проєкти Andrew Berezovskyi.',
      )}
    />
    <link rel="icon" type="image/svg+xml" href={localPath('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('Skip to content', 'До основного вмісту')}
    </a>
    <header class="site-header">
      <a
        class="wordmark"
        href={uk ? localPath('uk/') : localPath()}
        aria-label="Andrew Berezovskyi home"
      >
        ab<span>®</span>
      </a>
      <nav aria-label={t('Main navigation', 'Основна навігація')}>
        <a href="#work">{t('Work', 'Проєкти')}</a>
        <a href="#skills">{t('Skills', 'Навички')}</a>
        <a href="#about">{t('About', 'Про мене')}</a>
      </nav>
      <div class="header-right">
        <div class="languages">
          <a href={localPath()} aria-current={!uk ? 'page' : undefined}>
            EN
          </a>
          <span>/</span>
          <a href={localPath('uk/')} aria-current={uk ? 'page' : undefined}>
            UA
          </a>
        </div>
        <a
          class="resume-nav"
          href={localPath('andrew-berezovskyi-cv.pdf')}
          download="Andrew-Berezovskyi-CV.pdf"
          aria-label={t('Download CV (PDF)', 'Завантажити резюме (PDF)')}
        >
          CV{' '}
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4" />
          </svg>
        </a>
        <a class="contact-nav" href="#contact">
          {t('Let’s talk', 'Написати')} <span>↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-heading">
          <p class="eyebrow">
            {t(
              'DEVELOPER. BUILDER. CURIOUS MIND.',
              'РОЗРОБНИК. ІНЖЕНЕР. ДОСЛІДНИК.',
            )}
          </p>
          <h1 id="hero-title">
            Andrew
            <span>
              Berezovskyi<span class="title-period">.</span>
            </span>
          </h1>
        </div>
        <div class="hero-bottom">
          <div class="hero-intro">
            <p>
              {t('I turn complex ideas into', 'Перетворюю складні ідеї на')}
              <br />
              <strong>{t('things that work.', 'речі, що працюють.')}</strong>
            </p>
          </div>
          <a
            class="round-link"
            href="#work"
            aria-label={t('Explore selected work', 'Переглянути проєкти')}
          >
            <span aria-hidden="true">↓</span>
            <small>{t('Explore work', 'До проєктів')}</small>
          </a>
          <p class="hero-aside">
            {t('From the first line of code', 'Від першого рядка коду')}
            <br />
            {t('to the last little detail.', 'до останньої маленької деталі.')}
          </p>
        </div>
        <div class="hero-key" aria-hidden="true">
          <span>↵</span>
          <small>enter</small>
        </div>
      </section>
      <section
        id="skills"
        class="skills-section section-shell"
        aria-labelledby="skills-title"
      >
        <div class="section-kicker">
          <span>01 / {t('THE TOOLKIT', 'ІНСТРУМЕНТИ')}</span>
          <span>
            {t(
              'SMALL KEYS. BIG POSSIBILITIES.',
              'МАЛІ КЛАВІШІ. ВЕЛИКІ МОЖЛИВОСТІ.',
            )}
          </span>
        </div>
        <div class="section-title">
          <h2 id="skills-title" class="metal-title">
            {t('Skills', 'Навички')}
          </h2>
          <p>
            {t(
              'Different tools. One mindset: understand it, build it, make it better.',
              'Різні інструменти. Один підхід: зрозуміти, побудувати, вдосконалити.',
            )}
          </p>
        </div>
        <SkillsIsland client:visible lang={lang} />
      </section>
      <section
        id="work"
        class="work-section section-shell"
        aria-labelledby="work-title"
      >
        <div class="section-kicker">
          <span>02 / {t('SELECTED WORK', 'ВИБРАНІ ПРОЄКТИ')}</span>
          <span>2024 — 2026</span>
        </div>
        <div class="section-title">
          <h2 id="work-title">
            {t('Less talk.', 'Менше слів.')}
            <br />
            <em>{t('More build.', 'Більше справ.')}</em>
          </h2>
          <p>
            {t(
              'Desktop apps, web experiences and a little operating system. Take a look inside.',
              'Десктопні застосунки, вебпроєкти й невелика операційна система. Зазирни всередину.',
            )}
          </p>
        </div>
        <ProjectShowcase client:visible lang={lang} />
      </section>
      <section id="about" class="about-section section-shell">
        <div class="section-kicker">
          <span>03 / {t('BEHIND THE CODE', 'ЗА РЯДКАМИ КОДУ')}</span>
          <span>
            {t(
              'STILL LEARNING. ALWAYS BUILDING.',
              'ВЧУСЯ. ДОСЛІДЖУЮ. СТВОРЮЮ.',
            )}
          </span>
        </div>
        <div class="about-grid">
          <h2>
            {t('A developer with', 'Розробник із')}
            <br />
            <em>{t('an engineer’s mind.', 'мисленням інженера.')}</em>
          </h2>
          <div>
            <p>
              {t(
                'I’m Andrew, a developer based in Kyiv. I work with C# and .NET, build for the web, and occasionally go all the way down to the kernel.',
                'Я Andrew, розробник із Києва. Працюю з C# та .NET, створюю вебзастосунки й іноді досліджую системи аж до ядра.',
              )}
            </p>
            <p class="muted">
              {t(
                'Studying automation and robotics at Kyiv Polytechnic Institute. I like understanding how things work — and then making them work a little better.',
                'Навчаюся автоматизації та робототехніки в КПІ. Люблю розуміти, як працюють речі, і робити їх трохи кращими.',
              )}
            </p>
            <a class="text-link" href={github} target="_blank" rel="noreferrer">
              {t('Explore my GitHub', 'Мій GitHub')} ↗
            </a>
          </div>
        </div>
        <a
          class="certificate-card"
          href={certificate}
          target="_blank"
          rel="noreferrer"
        >
          <span class="credential-art" aria-hidden="true">
            <span class="microsoft-brand">
              <svg viewBox="0 0 23 23">
                <path fill="#f25022" d="M0 0h11v11H0z" />
                <path fill="#7fba00" d="M12 0h11v11H12z" />
                <path fill="#00a4ef" d="M0 12h11v11H0z" />
                <path fill="#ffb900" d="M12 12h11v11H12z" />
              </svg>
              Microsoft
            </span>
            <span class="credential-symbol">
              C<span>#</span>
            </span>
            <span class="credential-rule"></span>
            <span class="credential-caption">
              FOUNDATIONAL C#
              <br />
              freeCodeCamp × Microsoft
            </span>
          </span>
          <span class="cert-info">
            <span class="eyebrow">FREECODECAMP × MICROSOFT</span>
            <strong>Foundational C# with Microsoft</strong>
            <span class="muted">Andrew Berezovskyi · 29.09.2026</span>
          </span>
          <span class="cert-link">{t('View credential', 'Перевірити')} ↗</span>
        </a>
      </section>
      <section id="contact" class="contact-section section-shell">
        <div class="section-kicker">
          <span>04 / {t('WHAT’S NEXT?', 'ЩО ДАЛІ?')}</span>
          <span class="availability">
            <i></i>
            {t('LET’S FIND OUT', 'СТВОРІМО ЩОСЬ')}
          </span>
        </div>
        <h2>
          {t('Have something', 'Є цікава')}
          <br />
          {t('in mind?', 'ідея?')}
        </h2>
        <div class="contact-bottom">
          <p>
            {t(
              'An opportunity, a question, or a good idea.',
              'Пропозиція, запитання чи хороша ідея.',
            )}
            <br />
            {t('My inbox is open.', 'Буду радий поспілкуватися.')}
          </p>
          <ContactLinks client:visible lang={lang} />
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <a class="wordmark" href="#main">
        ab<span>®</span>
      </a>
      <span>© {new Date().getFullYear()} ANDREW BEREZOVSKYI</span>
      <span>
        {t('BUILT WITH INTENTION, IN KYIV.', 'СТВОРЕНО З ДУМКОЮ. У КИЄВІ.')}
      </span>
      <a href="#main">{t('BACK TO TOP', 'НАГОРУ')} ↑</a>
    </footer>
  </body>
</html>
